#!/usr/bin/env python3
"""Print host opencode-go API key from ~/.pi/agent/auth.json. Host-only, never used in sandbox."""
import json
import sys
from pathlib import Path


def main() -> None:
    try:
        raw = (Path.home() / ".pi" / "agent" / "auth.json").read_text()
    except OSError as e:
        print(f"error: cannot read auth.json: {e.strerror or e}", file=sys.stderr)
        sys.exit(1)
    try:
        data = json.loads(raw)
    except json.JSONDecodeError as e:
        print(f"error: invalid auth.json: {e}", file=sys.stderr)
        sys.exit(1)
    entry = data.get("opencode-go") if isinstance(data, dict) else None
    if not isinstance(entry, dict) or entry.get("type") != "api_key":
        print("error: missing or invalid opencode-go api_key entry", file=sys.stderr)
        sys.exit(1)
    key = entry.get("key")
    if not isinstance(key, str) or not key:
        print("error: missing or invalid opencode-go api_key entry", file=sys.stderr)
        sys.exit(1)
    if "$" in key or key.startswith("!"):
        print("error: opencode-go key is an unresolved reference, not a secret", file=sys.stderr)
        sys.exit(1)
    sys.stdout.write(key + "\n")


if __name__ == "__main__":
    main()
