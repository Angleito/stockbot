#!/usr/bin/env python3
"""Print host openai-codex accountId from ~/.pi/agent/auth.json. Host-only, never used in sandbox."""
import json
import re
import sys
from pathlib import Path


def main() -> None:
    try:
        raw = (Path.home() / ".pi" / "agent" / "auth.json").read_text()
    except OSError as e:
        print(f"error: cannot read auth.json: {e.strerror or e}", file=sys.stderr)
        sys.exit(1)
    try:
        data = json.loads(raw)
    except json.JSONDecodeError as e:
        print(f"error: invalid auth.json: {e}", file=sys.stderr)
        sys.exit(1)
    entry = data.get("openai-codex") if isinstance(data, dict) else None
    account = entry.get("accountId") if isinstance(entry, dict) else None
    if not isinstance(account, str) or not re.fullmatch(r"[A-Za-z0-9_-]+", account):
        print("error: missing or invalid openai-codex accountId", file=sys.stderr)
        sys.exit(1)
    sys.stdout.write(account + "\n")


if __name__ == "__main__":
    main()
