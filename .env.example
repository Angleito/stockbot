# Required for SEC EDGAR requests. SEC requires an identifying User-Agent.
SEC_EDGAR_IDENTITY="Your Name your.email@example.com"

# Required for OpenRouter-backed chat and LLM-generated earnings summaries.
OPENROUTER_API_KEY="sk-or-..."

# Optional: overrides the default OpenRouter model.
# DEFAULT_MODEL="google/gemini-2.5-flash"

# Optional: enables FINRA's credentialed Query API. Not needed for offline tests.
FINRA_CLIENT_ID="your_finra_client_id"
FINRA_CLIENT_SECRET="your_finra_client_secret"

# Testing only: use FINRA mock datasets rather than production datasets.
# FINRA_USE_MOCK="false"

# Optional: enables the read-only Robinhood MCP integration. OAuth credentials
# are stored locally at ~/.stockbot/robinhood/oauth.json with restrictive permissions.
ROBINHOOD_ENABLED="false"
# ROBINHOOD_MCP_URL="https://agent.robinhood.com/mcp/trading"

# Optional: uses a secondary OpenRouter model to phrase FINRA briefings.
# When unset, FINRA briefings are deterministic only.
# FINRA_ANALYSIS_MODEL="google/gemini-2.5-flash"
