# Required for SEC EDGAR requests. SEC requires an identifying User-Agent.
SEC_EDGAR_IDENTITY="Your Name your.email@example.com"

# Required for OpenRouter-backed chat and LLM-generated earnings summaries.
OPENROUTER_API_KEY="sk-or-..."

# Optional: overrides the default OpenRouter model.
# DEFAULT_MODEL="google/gemini-2.5-flash"

# Required to enable POST /chat. API clients send the matching value as
# Authorization: Bearer <secret>. Use long random secrets; do not commit them.
# Multiple users use comma-separated user=secret entries.
# API_AUTH_TOKENS="alice=replace-with-a-long-random-secret,bob=another-long-random-secret"
# Legacy single-user alternative (principal name: local):
# API_AUTH_TOKEN="replace-with-a-long-random-secret"
# Only these users may invoke account/portfolio and saved-scanner tools.
# API_PORTFOLIO_USERS="alice"

# Server-controlled /chat bounds. The default model is always allowed; add
# any additional selectable models explicitly rather than trusting clients.
# CHAT_ALLOWED_MODELS="google/gemini-2.5-flash"
# CHAT_MAX_MESSAGES="20"
# CHAT_MAX_CONTENT_CHARS="12000"
# CHAT_MAX_REQUEST_BYTES="64000"
# CHAT_CONCURRENCY_LIMIT="4"
# CHAT_RATE_LIMIT_REQUESTS="20"
# CHAT_RATE_LIMIT_WINDOW_SECONDS="60"
# OPENROUTER_TIMEOUT_SECONDS="60"

# Optional: enables FINRA's credentialed Query API. Not needed for offline tests.
FINRA_CLIENT_ID="your_finra_client_id"
FINRA_CLIENT_SECRET="your_finra_client_secret"

# Testing only: use FINRA mock datasets rather than production datasets.
# FINRA_USE_MOCK="false"

# Optional: enables the read-only Robinhood MCP integration. OAuth credentials
# are stored locally at ~/.stockbot/robinhood/oauth.json with restrictive permissions.
ROBINHOOD_ENABLED="false"
# OAuth is pinned to https://agent.robinhood.com/mcp/trading.

# Optional: uses a secondary OpenRouter model to phrase FINRA briefings.
# When unset, FINRA briefings are deterministic only.
# FINRA_ANALYSIS_MODEL="google/gemini-2.5-flash"
