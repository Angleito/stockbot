# SEC EDGAR requires all API requests to declare a User-Agent in the format:
# User-Agent: Sample Company Name AdminContact@<sample company domain>.com
# Replace with your actual name and email address:
SEC_EDGAR_IDENTITY="YourName your.email@domain.com"

# OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY="sk-or-..."

# Massive API key (https://massive.com/dashboard/keys)
# Free tier available at $0/month (Stocks Basic plan)
MASSIVE_API_KEY="your_massive_api_key_here"

# FINRA Query API (https://developer.finra.org) — Public credential.
# Create an Individual account, provision a Public API credential, then set:
FINRA_CLIENT_ID="your_finra_client_id"
FINRA_CLIENT_SECRET="your_finra_client_secret"
# Set true to query *Mock datasets instead of production (same credentials type: Mock).
FINRA_USE_MOCK="false"

# Default OpenRouter model string (provider/model-name).
# Overridable via CLI --model flag or the /chat API "model" field.
# Use a model ID that is valid for your OpenRouter account.
DEFAULT_MODEL="google/gemini-2.5-flash"

# Optional secondary low-cost OpenRouter model used only to phrase FINRA
# briefings (deterministic summaries are always computed locally). When
# unset or blank, FINRA briefings are deterministic-only — no LLM call.
# FINRA_ANALYSIS_MODEL="deepseek/deepseek-chat"
