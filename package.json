{
  "name": "stockbot",
  "private": true,
  "scripts": {
    "setup": "python3.14 -m venv venv && venv/bin/pip install --upgrade pip && venv/bin/pip install -r requirements.txt",
    "test": "venv/bin/pytest && bun test tests/pi_extension.test.ts",
    "typecheck": "venv/bin/pyrefly check",
    "typecheck-ts": "tsc --noEmit -p tsconfig.json",
    "test-collect": "venv/bin/pytest --collect-only -q",
    "coverage:py": "venv/bin/coverage run -m pytest; venv/bin/coverage lcov -o coverage-python.lcov",
    "coverage:ts": "bun test tests/pi_extension.test.ts --coverage --coverage-reporter=lcov --coverage-dir=coverage-ts",
    "coverage:rs": "[ -f Cargo.toml ] || exit 0; cargo llvm-cov --lcov --output-path coverage-rust.lcov",
    "coverage": "bun run coverage:py && bun run coverage:ts && bun run coverage:rs",
    "crap": "poly-crap --coverage coverage-python.lcov --coverage coverage-ts/lcov.info $([ -f coverage-rust.lcov ] && echo \"--coverage coverage-rust.lcov\")",
    "crap:changed": "GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=diff.mnemonicprefix GIT_CONFIG_VALUE_0=false poly-crap --diff-base main --fail-above --coverage coverage-python.lcov --coverage coverage-ts/lcov.info $([ -f coverage-rust.lcov ] && echo \"--coverage coverage-rust.lcov\")",
    "smoke-mock": "RUN_FINRA_SMOKE=1 venv/bin/pytest -m finra_smoke -q",
    "smoke-prod": "RUN_FINRA_PRODUCTION_SMOKE=1 venv/bin/pytest -m finra_production_smoke -q",
    "smoke-robinhood": "RUN_ROBINHOOD_SMOKE=1 venv/bin/pytest -m robinhood_smoke -q",
    "smoke": "bun run smoke-mock && bun run smoke-prod",
    "clean-env": "rm -rf venv",
    "verify-tools": "venv/bin/python scripts/verify_tool_registry.py",
    "verify-tool-health": "venv/bin/python scripts/verify_tool_health.py",
    "verify-holdout": "venv/bin/python scripts/verify_pi_tools.py --holdout",
    "verify-pi": "venv/bin/python scripts/verify_pi_tools.py --routing",
    "verify-confusion": "venv/bin/python scripts/verify_pi_tools.py --confusion",
    "verify-pi-one": "venv/bin/python scripts/verify_pi_tools.py --tool",
    "verify-judge": "venv/bin/python scripts/verify_judge.py --all",
    "verify-judge-self-check": "venv/bin/python scripts/verify_judge.py --self-check",
    "verify-judge-one": "venv/bin/python scripts/verify_judge.py --scenario",
    "verify-strict": "venv/bin/python scripts/strict_routing_harness.py",
    "verify-harness": "venv/bin/python -m pytest tests/test_research_harness.py tests/test_research_timeout_resume.py -q",
    "verify-agent": "venv/bin/python scripts/verify_agent_scenarios.py --model \"${STOCKBOT_MODEL}\" --provider \"${STOCKBOT_PROVIDER}\"",
    "verify:live": "bun run verify-agent",
    "eval:routing": "venv/bin/python scripts/verify_pi_tools.py --routing && venv/bin/python scripts/strict_routing_harness.py",
    "eval:confusion": "venv/bin/python scripts/verify_pi_tools.py --confusion",
    "eval:holdout": "venv/bin/python scripts/verify_pi_tools.py --holdout",
    "eval:model": "venv/bin/python scripts/verify_judge.py --all",
    "eval:full": "venv/bin/python scripts/verify_pi_tools.py --routing && venv/bin/python scripts/verify_pi_tools.py --confusion && venv/bin/python scripts/verify_judge.py --all",
    "eval:typesafe": "bun test ./tests/typesafe_live.eval.ts",
    "verify:e2e": "FINRA_USE_MOCK=0 venv/bin/python scripts/verify_pi_tools.py --agent-loop",
    "verify-integrity": "venv/bin/python scripts/verify_type_escape_hatches.py",
    "verify-secrets": "gitleaks git . --no-banner --config .gitleaks.toml --redact",
    "verify-deps": "osv-scanner scan source -r . --no-resolve --config osv-scanner.toml",
    "update-tool-inventory": "venv/bin/python scripts/update_tool_inventory.py",
    "update-tool-catalog": "venv/bin/python scripts/update_tool_catalog.py",
    "verify": "bun run clean-env && bun run setup && bun run test && bun run typecheck && bun run typecheck-ts && bun run lint && bun run verify-integrity && bun run verify-secrets && bun run verify-deps && bun run verify-tools && bun run verify-tool-health && bun run verify-judge-self-check && bun run verify-harness",
    "sandbox-doctor": "venv/bin/python scripts/sandbox_doctor.py",
    "stockbot": "omp --config .stockbot/omp/stockbot.yml --no-extensions --no-skills --no-rules --no-lsp --tools=task -e .stockbot/omp ${STOCKBOT_MODEL:+--model \"$STOCKBOT_MODEL\"}",
    "stockbot:granite": "STOCKBOT_MODEL=lmstudio-community/granite-4.1-8b-GGUF:Q4_K_M bun run stockbot",
    "llama": "llama-server --models-dir ${HOME}/.cache/huggingface/hub --models-preset ${HOME}/.config/llama-server/presets.ini --models-max 1 --host 127.0.0.1 --port 8080",
    "lint": "venv/bin/ruff check . && venv/bin/ruff format --check ."
  },
  "dependencies": {
    "@oh-my-pi/pi-coding-agent": "18.2.3",
    "@oh-my-pi/pi-tui": "18.2.3",
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "bun-types": "^1.4.2",
    "fast-check": "^4.10.0",
    "knip": "^6.35.1",
    "typescript": "^7.0.2"
  }
}
